# Copy to .env and fill in. Never commit the real .env.

# --- API ---
PORT=4000
NODE_ENV=development

# SQLite by default (zero setup, used for local dev/test).
# For the production topology (docker-compose / AWS), point this at Postgres
# with the pgvector extension instead, e.g.:
#   postgresql://shopsphere:shopsphere@localhost:5432/shopsphere
DATABASE_URL="file:./dev.db"

JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="1h"

# LLM_PROVIDER=mock avoids any real API calls (used by default in tests / CI).
# Set to "claude" and provide ANTHROPIC_API_KEY to get real assistant responses.
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Set true only when you intentionally want live-LLM Playwright tests to run.
LIVE_LLM_TESTS=false

# --- Web ---
VITE_API_BASE_URL="http://localhost:4000"
VITE_GRAPHQL_URL="http://localhost:4000/graphql"

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
LOG_LEVEL="info"
